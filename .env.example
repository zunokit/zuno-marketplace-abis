# Zuno Marketplace ABIs - Environment Variables Template
# Copy this file to .env and fill in your values

# =============================================================================
# Database
# =============================================================================
# Production: Neon serverless Postgres (HTTP driver) - see drizzle/client.ts.
# Local Docker (see docker-compose.yml):
#   postgresql://zuno_user:zuno_pass@localhost:5434/zuno_abis
# NOTE: The plain Postgres above works for drizzle-kit (migrations, db:push)
# but the runtime uses drizzle-orm/neon-http and will NOT talk to it directly.
# For full app runtime locally, use a Neon dev branch or switch the runtime
# driver. See README.md "Local Docker Dev Stack" for details.
DATABASE_URL="postgresql://zuno_user:zuno_pass@localhost:5434/zuno_abis"

# =============================================================================
# Authentication (Better Auth)
# =============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# =============================================================================
# Cache (Upstash Redis)
# =============================================================================
# Production: Upstash REST endpoint - get free tier at: https://console.upstash.com
# Local Docker: hiett/serverless-redis-http proxy in docker-compose.yml
#   UPSTASH_REDIS_REST_URL=http://localhost:8079
#   UPSTASH_REDIS_REST_TOKEN=zuno_local_dev_token
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="zuno_local_dev_token"

# =============================================================================
# IPFS Storage (Pinata)
# =============================================================================
# Get free tier at: https://app.pinata.cloud
PINATA_JWT="your-pinata-jwt-token"
PINATA_GATEWAY_URL="https://gateway.pinata.cloud"
PINATA_UPLOAD_ENABLED=false
# =============================================================================
# Sentry Error Tracking
# =============================================================================
# Get DSN from: https://sentry.io/settings/projects/
# Optional - Leave empty to disable Sentry
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/project-id"
SENTRY_DSN="https://your-dsn@sentry.io/project-id"

# Sentry Authentication Token (for CLI releases)
# Generate at: https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN="sntrys_..."

# Enable/disable Sentry (default: true if DSN is set)
# Set to "false" to disable Sentry even if DSN is configured
SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_ENABLED="false"

SENTRY_ORG=
SENTRY_PROJECT=
# Override sampling rates (optional)
# SENTRY_TRACES_SAMPLE_RATE="1.0"  # 0.0 to 1.0
# SENTRY_PROFILES_SAMPLE_RATE="0.1"  # 0.0 to 1.0

# Debug mode (only for local development)
# SENTRY_DEBUG="false"

# =============================================================================
# Public Configuration
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Admin Account (for seeding)
# =============================================================================
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="admin123"

# =============================================================================
# API Keys (Hardcoded Admin Keys)
# =============================================================================
# Format: API_KEYS=zuno_xxx_admin_01,zuno_xxx_admin_02
# These keys bypass rate limiting
# API_KEYS=""

# =============================================================================
# Public API Key Issuance
# =============================================================================
# Public user ID for the free-tier API key
# PUBLIC_API_USER_ID="user_v1_public"

# =============================================================================
# Foundry Contracts (for seeding ABIs)
# =============================================================================
FOUNDRY_OUT_DIR="../zuno-marketplace-contracts/out"
FOUNDRY_BROADCAST_DIR="../zuno-marketplace-contracts/broadcast"

# =============================================================================
# Node Environment
# =============================================================================
NODE_ENV="development"

# =============================================================================
# Development Only
# =============================================================================
# Skip environment validation (use with caution)
# SKIP_ENV_VALIDATION="false"
