          // Pick a random ABI and network
          const randomAbi =
            existingAbis[Math.floor(Math.random() * existingAbis.length)];
          const randomNetwork =
            existingNetworks[
              Math.floor(Math.random() * existingNetworks.length)
            ];

          const contractId = IdGenerator.generate({
