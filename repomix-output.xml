const copyAddress = (address: string) => {
  navigator.clipboard.writeText(address);
  toast.success("Address copied to clipboard");
};

export function createContractColumns({
  onView,
  onDelete,
}: ActionsProps): ColumnDef<Contract>[] {
  return [
    {
