  },

  // URLs
  urls: {
    app: env.NEXT_PUBLIC_APP_URL,
    api: `${env.NEXT_PUBLIC_APP_URL}/api`,
    docs: `${env.NEXT_PUBLIC_APP_URL}/docs`,
  },

  // Features
  features: {
    sentry: false, // !!env.SENTRY_DSN when enabled
    analytics: env.NODE_ENV === "production",
    debugMode: env.NODE_ENV === "development",
  },
} as const;

