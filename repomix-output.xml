          <Button
            variant="ghost"
            size="sm"
            onClick={() => copyAddress(row.original.address)}
          >
            <Copy className="h-3 w-3" />
          </Button>
        </div>
      ),
    },
    {
      accessorKey: "networkId",
      header: "Network ID",
    },
    {
