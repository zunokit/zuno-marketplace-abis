    // 3. Convert to FULL DTOs (with ABI JSON)
    return AbiDtoMapper.toFullPaginatedResponseDto(result);
  },
  {
    validation: {
      query: ListAbisSchema,
    },
    auth: {
      required: true,
      allowApiKey: true,
      allowSession: true,
    },
  }
);
