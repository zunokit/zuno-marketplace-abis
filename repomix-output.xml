        success: false,
        error: result.error,
        jobId: result.jobId,
      };
    }

    return {
      success: true,
      jobId: result.jobId,
      recordsRestored: result.recordsRestored,
      completedAt: result.completedAt,
    };
  },
  {
    auth: {
      required: true,
