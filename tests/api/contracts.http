###############################################################################
# 11. INTEGRATION WORKFLOW
###############################################################################

### 11.1. Complete Workflow: Create ABI → Create Contract → Get Contract → Update → Delete
# Step 1: Create ABI first (see abis.http)
# Step 2: Create Contract with that ABI

POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "name": "Workflow Test Contract",
  "type": "token",
  "metadata": {
    "symbol": "WTC",
    "decimals": 18
  }
}

# Step 3: Get the contract
### GET {{apiUrl}}/contracts/0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb?networkId={{networkId}}

# Step 4: Update the contract
### PUT {{apiUrl}}/contracts/0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb?networkId={{networkId}}

# Step 5: Delete the contract
### DELETE {{apiUrl}}/contracts/0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb?networkId={{networkId}}
