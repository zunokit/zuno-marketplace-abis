### ABI Marketplace - Contract Management Tests
### Base URL
@baseUrl = http://localhost:3000
@apiUrl = {{baseUrl}}/api

### Variables (Update these after creating resources)
@apiKey = zuno_your_api_key_here
@sessionToken = your_session_token_here
@contractAddress = 0x1234567890abcdef1234567890abcdef12345678
@networkId = network-uuid-here
@abiId = abi-uuid-here
@versionId = version-uuid-here

###############################################################################
# 1. CONTRACT ENDPOINTS (Requires API Key)
###############################################################################

### 1.1. List All Contracts (Requires API Key)
GET {{apiUrl}}/contracts?page=1&limit=20&sortBy=createdAt&sortOrder=desc
X-API-Key: {{apiKey}}
Accept: application/json

### 1.2. Search Contracts by Name or Address
GET {{apiUrl}}/contracts?query=USDC&page=1&limit=10
X-API-Key: {{apiKey}}
Accept: application/json

### 1.3. Filter by Network ID
GET {{apiUrl}}/contracts?networkId={{networkId}}&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 1.4. Filter by ABI ID
GET {{apiUrl}}/contracts?abiId={{abiId}}&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 1.5. Filter by Contract Type
GET {{apiUrl}}/contracts?type=token&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 1.6. Filter Verified Contracts Only
GET {{apiUrl}}/contracts?isVerified=true&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 1.7. Filter by Deployer Address
GET {{apiUrl}}/contracts?deployer=0xabcdefabcdefabcdefabcdefabcdefabcdefabcd
X-API-Key: {{apiKey}}
Accept: application/json

### 1.8. Complex Filter (Type + Verified + Network)
GET {{apiUrl}}/contracts?type=token&isVerified=true&networkId={{networkId}}&limit=10
X-API-Key: {{apiKey}}
Accept: application/json

### 1.9. Sort by Name
GET {{apiUrl}}/contracts?sortBy=name&sortOrder=asc&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 1.10. Sort by Deployed Date
GET {{apiUrl}}/contracts?sortBy=deployedAt&sortOrder=desc&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

###############################################################################
# 2. GET CONTRACT DETAILS (Requires API Key)
###############################################################################

### 2.1. Get Contract by Address (Without ABI)
GET {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
X-API-Key: {{apiKey}}
Accept: application/json

### 2.2. Get Contract by Address (With ABI)
GET {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}&includeAbi=true
X-API-Key: {{apiKey}}
Accept: application/json

### 2.3. Get Contract's ABI Only
GET {{apiUrl}}/contracts/{{contractAddress}}/abi?networkId={{networkId}}
X-API-Key: {{apiKey}}
Accept: application/json

### 2.4. Get Contract ABI Versions
GET {{apiUrl}}/contracts/{{contractAddress}}/versions?networkId={{networkId}}
X-API-Key: {{apiKey}}
Accept: application/json

### 2.5. Get Specific ABI Version
GET {{apiUrl}}/contracts/{{contractAddress}}/versions/{{versionId}}?networkId={{networkId}}
X-API-Key: {{apiKey}}
Accept: application/json

###############################################################################
# 2.6. CONTRACT BY NAME ENDPOINTS
###############################################################################

### 2.6.1. Find Contracts by Name
GET {{apiUrl}}/contracts/by-name/USDC?page=1&limit=20&sortBy=name&sortOrder=asc
X-API-Key: {{apiKey}}
Accept: application/json

### 2.6.2. Find Contracts by Name with Network Filter
GET {{apiUrl}}/contracts/by-name/USDC?networkId={{networkId}}&page=1&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 2.6.3. Get ABI Versions for Contracts with Name
GET {{apiUrl}}/contracts/by-name/USDC/versions?networkId={{networkId}}
X-API-Key: {{apiKey}}
Accept: application/json

### 2.6.4. Get ABI Versions for Contracts with Name (All Networks)
GET {{apiUrl}}/contracts/by-name/USDC/versions
X-API-Key: {{apiKey}}
Accept: application/json

###############################################################################
# 3. AUTHENTICATED - REGISTER CONTRACTS (API Key)
###############################################################################

### 3.1. Register ERC20 Token Contract
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x1234567890abcdef1234567890abcdef12345678",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "name": "USDC Token",
  "type": "token",
  "metadata": {
    "symbol": "USDC",
    "decimals": 6,
    "totalSupply": "1000000000000000"
  },
  "deployedAt": "2024-01-15T10:00:00Z",
  "deployer": "0xabcdefabcdefabcdefabcdefabcdefabcdefabcd"
}

### 3.2. Register ERC721 NFT Contract
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0xabcdefabcdefabcdefabcdefabcdefabcdefabcd",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "name": "Bored Ape NFT",
  "type": "nft",
  "metadata": {
    "symbol": "BAYC",
    "totalSupply": "10000"
  },
  "deployer": "0x1111111111111111111111111111111111111111"
}

### 3.3. Register DeFi Protocol Contract
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x9876543210fedcba9876543210fedcba98765432",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "name": "Uniswap V3 Pool",
  "type": "defi",
  "metadata": {
    "symbol": "USDC-ETH",
    "decimals": 18
  }
}

### 3.4. Register Upgradeable Proxy Contract
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x5555555555555555555555555555555555555555",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "name": "Upgradeable Token Proxy",
  "type": "token",
  "metadata": {
    "symbol": "UPG",
    "decimals": 18,
    "isProxy": true,
    "implementation": "0x6666666666666666666666666666666666666666"
  }
}

### 3.5. Register DAO Contract
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x7777777777777777777777777777777777777777",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "name": "Community DAO",
  "type": "dao"
}

### 3.6. Register Bridge Contract
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x8888888888888888888888888888888888888888",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "name": "Cross-Chain Bridge",
  "type": "bridge"
}

###############################################################################
# 4. AUTHENTICATED - UPDATE CONTRACTS (API Key)
###############################################################################

### 4.1. Update Contract Name
PUT {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "name": "USDC Token (Updated)"
}

### 4.2. Update Contract Metadata
PUT {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "metadata": {
    "symbol": "USDC",
    "decimals": 6,
    "totalSupply": "2000000000000000",
    "note": "Supply increased"
  }
}

### 4.3. Mark Contract as Verified
PUT {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "isVerified": true,
  "verificationSource": "etherscan"
}

### 4.4. Switch to Different ABI
PUT {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "abiId": "new-abi-uuid-here"
}

### 4.5. Update Deployer Information
PUT {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "deployer": "0x9999999999999999999999999999999999999999",
  "deployedAt": "2024-01-15T15:30:00Z"
}

### 4.6. Update Contract Type
PUT {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "type": "defi"
}

###############################################################################
# 5. AUTHENTICATED - DELETE CONTRACTS (API Key)
###############################################################################

### 5.1. Delete Contract by Address
DELETE {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
X-API-Key: {{apiKey}}

###############################################################################
# 6. AUTHENTICATED - SESSION-BASED REQUESTS
###############################################################################

### 6.1. Register Contract with Session
POST {{apiUrl}}/contracts
Content-Type: application/json
Cookie: better-auth.session_token={{sessionToken}}

{
  "address": "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "name": "Session Created Contract",
  "type": "token"
}

### 6.2. Update Contract with Session
PUT {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Content-Type: application/json
Cookie: better-auth.session_token={{sessionToken}}

{
  "name": "Updated via Session"
}

### 6.3. Delete Contract with Session
DELETE {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Cookie: better-auth.session_token={{sessionToken}}

###############################################################################
# 7. NETWORK ENDPOINTS (Requires API Key)
###############################################################################

### 7.1. List All Networks
GET {{apiUrl}}/networks?page=1&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 7.2. List All Networks (No Pagination)
GET {{apiUrl}}/networks?all=true
X-API-Key: {{apiKey}}
Accept: application/json

### 7.3. List Active Networks Only
GET {{apiUrl}}/networks?isActive=true&all=true
X-API-Key: {{apiKey}}
Accept: application/json

### 7.4. Filter Mainnets Only
GET {{apiUrl}}/networks?isTestnet=false&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 7.5. Filter Testnets Only
GET {{apiUrl}}/networks?isTestnet=true&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 7.6. Filter by Network Type
GET {{apiUrl}}/networks?type=mainnet&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 7.7. Search Networks by Name
GET {{apiUrl}}/networks?query=ethereum&limit=10
X-API-Key: {{apiKey}}
Accept: application/json

### 7.8. Sort Networks by Chain ID
GET {{apiUrl}}/networks?sortBy=chainId&sortOrder=asc&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 7.9. Get Contracts on Ethereum (Chain ID 1)
GET {{apiUrl}}/networks/1/contracts?page=1&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 7.10. Get Contracts on Polygon (Chain ID 137)
GET {{apiUrl}}/networks/137/contracts?page=1&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 7.11. Get Verified Contracts on Ethereum
GET {{apiUrl}}/networks/1/contracts?isVerified=true&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

### 7.12. Get Token Contracts on BSC (Chain ID 56)
GET {{apiUrl}}/networks/56/contracts?type=token&limit=20
X-API-Key: {{apiKey}}
Accept: application/json

###############################################################################
# 8. ERROR CASES & EDGE CASES
###############################################################################

### 8.1. Create Contract without Authentication (Should Fail - 401)
POST {{apiUrl}}/contracts
Content-Type: application/json

{
  "address": "0xtest",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}"
}

### 8.2. Create Contract with Invalid API Key (Should Fail - 401)
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: invalid_key_123

{
  "address": "0xtest",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}"
}

### 8.3. Create Contract with Invalid Address (Should Fail - 400)
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "invalid-address",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}"
}

### 8.4. Create Contract with Non-existent ABI (Should Fail - 404)
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x1234567890123456789012345678901234567890",
  "networkId": "{{networkId}}",
  "abiId": "00000000-0000-0000-0000-000000000000"
}

### 8.5. Create Contract with Non-existent Network (Should Fail - 404)
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x1234567890123456789012345678901234567890",
  "networkId": "00000000-0000-0000-0000-000000000000",
  "abiId": "{{abiId}}"
}

### 8.6. Create Duplicate Contract (Should Fail - 409)
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "{{contractAddress}}",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}"
}

### 8.7. Get Contract without Network ID (Should Fail - 400)
GET {{apiUrl}}/contracts/{{contractAddress}}
Accept: application/json

### 8.8. Get Non-existent Contract (Should Fail - 404)
GET {{apiUrl}}/contracts/0x0000000000000000000000000000000000000000?networkId={{networkId}}
Accept: application/json

### 8.9. Update Contract without Network ID (Should Fail - 400)
PUT {{apiUrl}}/contracts/{{contractAddress}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "name": "Test"
}

### 8.10. Update Non-existent Contract (Should Fail - 404)
PUT {{apiUrl}}/contracts/0x0000000000000000000000000000000000000000?networkId={{networkId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "name": "Test"
}

### 8.11. Delete Contract without Network ID (Should Fail - 400)
DELETE {{apiUrl}}/contracts/{{contractAddress}}
X-API-Key: {{apiKey}}

### 8.12. Delete Non-existent Contract (Should Fail - 404)
DELETE {{apiUrl}}/contracts/0x0000000000000000000000000000000000000000?networkId={{networkId}}
X-API-Key: {{apiKey}}

### 8.13. Get Contracts for Non-existent Network (Should Fail - 404)
GET {{apiUrl}}/networks/999999/contracts
Accept: application/json

### 8.14. Missing Required Fields (Should Fail - 400)
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x1234567890123456789012345678901234567890"
}

### 8.15. Invalid Contract Type (Should Fail - 400)
POST {{apiUrl}}/contracts
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "address": "0x1234567890123456789012345678901234567890",
  "networkId": "{{networkId}}",
  "abiId": "{{abiId}}",
  "type": "invalid-type"
}

### 8.16. Invalid Verification Source (Should Fail - 400)
PUT {{apiUrl}}/contracts/{{contractAddress}}?networkId={{networkId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "verificationSource": "invalid-source"
}

